# LLM Provider Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# MinIO S3-Compatible Cloud Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=contracts-bucket
MINIO_SECURE=false

# ChromaDB Vector Store
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# Tracing & Observability (Arize Phoenix / LangSmith)
OBSERVABILITY_PROVIDER=phoenix  # Options: phoenix, langsmith
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# LangSmith (Optional, if using LangSmith)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=contract-audit-agent

# FastAPI Service
API_HOST=0.0.0.0
API_PORT=8080
